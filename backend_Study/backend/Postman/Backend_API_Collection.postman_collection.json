      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Get posts succeeds\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "pm.test(\"Response is valid JSON\", () => pm.response.to.have.jsonBody());",
              "const d = pm.response.json();",
              "const posts = d.posts || d.data || d;",
              "pm.test(\"Posts are returned as an array\", () => pm.expect(posts).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
